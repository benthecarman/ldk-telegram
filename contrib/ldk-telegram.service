[Unit]
Description=Telegram bot for LDK Server
After=network-online.target ldk-server.service
Wants=network-online.target

[Service]
# The bot sends READY=1 once it has reached Telegram, STATUS= updates about its ldk-server
# connection, and watchdog pings.
Type=notify
NotifyAccess=main
WatchdogSec=60
ExecStart=/usr/local/bin/ldk-telegram --config /etc/ldk-telegram/config.toml

# Exit code 0 (SIGTERM or the /stop command) stays stopped; errors such as an unreachable
# Telegram API at boot are retried.
Restart=on-failure
RestartSec=10
# The bot gives itself 8 seconds to stop cleanly, so this is only a backstop.
TimeoutStopSec=15

# Secrets are passed as credentials, so the bot needs no access to ldk-server's data directory.
# Any credential can be left out if the config file sets the matching path instead.
LoadCredential=bot-token:/etc/ldk-telegram/bot-token
LoadCredential=macaroon:/etc/ldk-telegram/telegram.macaroon
LoadCredential=tls-cert:/var/lib/ldk-server/tls.crt

# Security hardening
DynamicUser=yes
UMask=0077
CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectClock=yes
ProtectHostname=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

[Install]
WantedBy=multi-user.target
